{
    // The NV in a 10 ppm P1 bath at zero field, gCCE2 (the NV a spin 1 with its zero-field splitting): one bath
    // configuration and one sampled bath state. ccein_without_ZFS.jsonc is the same without the splitting.
    // Sampled bath states: configuration.s_range [1, 1], each state s its own output _state<s>.
    //
    // The physics: at zero field the P1 have no Zeeman splitting and the NV levels come from its zero-field splitting
    // alone: ms 0 at the bottom and ms +1, -1 together D = 2.88 GHz above. In gCCE the NV is in every cluster's
    // Hamiltonian, so it needs this splitting written (intmap); without it the ms +1 and -1 levels are degenerate
    // and the divided curve (_wiDiv) diverges: |L| reaches 4.6e37 (README, cut at 1.2 in expected.png). T2 with the
    // splitting 3.59 us. Writes results/ccein_with_ZFS_state1_wiDiv and _noDiv.
    //
    // The two inputs differ only in Qubit.intmap. Against the other inputs: 10 ppm (shorter times, smaller rbath and
    // rdip), bfield 0 and one bath state.
    // Every key not written here has its default (main.out -e writes them all).

    "method"        : "gCCE",         // the NV (qubit) is in every cluster's Hamiltonian with its own levels, which
                                      // is where the zero-field splitting enters
    // the NV written out (spin 1 with its zero-field splitting D = 2.88 GHz, as a tensor in kHz): ms +1 / 0
    "Qubit"         : {"qubit" : [{"name": "NV", "xyz": [523.336, 524.936, 521.003]}],
                       "alpha_state" : {"ms": [1]},
                       "beta_state" : {"ms": [0]},
                       "intmap": [{"between": ["NV", "NV"],
                                   "tensor": [[-960000, 0, 0], [0, -960000, 0], [0, 0, 1920000]]}]},
                                      // "name" is what intmap refers to; "xyz" the position in Angstrom (the same as
                                      // bath/14N_10ppm/bath_DiaP1_10ppm_Defect); spin 1 and the electron gyromagnetic
                                      // ratio are the defaults. L(t) between ms +1 (alpha_state) and 0 (beta_state).
                                      // intmap: a qubit-qubit tensor; ["NV", "NV"], the same name twice, is a self
                                      // term S.T.S, here the zero-field splitting as diag(-D/3, -D/3, 2D/3) with
                                      // D = 2.88 GHz, in kHz (a tensor without "unit" is kHz; the log notes it).
                                      // ccein_without_ZFS.jsonc leaves intmap out
    "configuration" : {"gyrofile": "../../../basic/06_defect_bath/bath/DiaP1_gyro",
                       "bathfile": ["../../../basic/06_defect_bath/bath/14N_10ppm/bath_DiaP1_10ppm_1"],
                       "s_range" : [1, 1],
                       "seed"    : 8810},
                                      // the bath. gyrofile: the P1 as a spin 1/2 with the electron's gyromagnetic
                                      // ratio (rad kHz/G). bathfile: one 10 ppm configuration, 410 P1 within rbath.
                                      // s_range [1, 1]: one pure bath state (more, e.g. [1, 10], before comparing
                                      // T2). seed 8810: draws the P1 axis states and the bath state; the same in both
    "order"         : 2,              // gCCE2: the NV with single P1 and with pairs of P1
    "bfield"        : 0,              // Gauss: zero field, the case where the zero-field splitting decides. README
                                      // suggests bfield 10 without the splitting as the next step
    "rbath"         : 370,            // Angstrom: the P1 within 370 A of the NV are kept (10 ppm: denser than 1 ppm,
                                      // so a smaller radius holds a similar number)
    "rdip"          : 330,            // Angstrom: two P1 closer than 330 A form a pair cluster
    "deltat"        : 5e-05,          // ms: the time step, 50 ns. t is the whole echo time 2 tau
    "nstep"         : 100,            // 100 points: t = 0 .. 4.95 us
    "pulse"         : {"count": 1},   // one pi pulse: the Hahn echo

    // The P1 centre: substitutional N, an electron spin 1/2 on a 14N (I = 1). Defect.species makes every bath spin
    // named "P1" this defect. The 14N is not a spin of its own here (n_onsite_spins 0, the default): its hyperfine
    // enters only as a static shift A_zz m_I of the electron, the detuning. A P1 has four Jahn-Teller axes (the four
    // C-N bond directions) and three m_I: 4 x 3 = 12 axis states, and each P1 is given one of them at random (from
    // configuration.seed; configuration.defect_axis_file gives them from a file instead).
    "Defect"        : {"species": [{
        "name"          : "P1",       // the name in the bath file this species applies to
        "n_axis_states" : 12,         // the indexed states 1 .. 12 that "detuning" lists
        "detuning"      : [[1, "e",  84.946496], [2, "e",  84.946496], [3,  "e",  84.946496],
                           [4, "e",   0.0],      [5, "e",   0.0],      [6,  "e",   0.0],
                           [7, "e", -84.946496], [8, "e", -84.946496], [9,  "e", -84.946496],
                           [10, "e", 114.0264],  [11, "e",  0.0],      [12, "e", -114.0264]]}]}
                                      // [axis state, "e" (the electron), MHz]. 1-9: the three axes tilted from z,
                                      // A_zz 84.946496 MHz, m_I +1 (1-3), 0 (4-6), -1 (7-9). 10-12: the axis along z,
                                      // A_zz = A_par 114.0264 MHz, m_I +1, 0, -1
}
