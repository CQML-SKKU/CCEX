{
    // basic/01_first_run's NV (with its zero-field splitting, kHz) in a field tilted from the NV axis ([50, 0, 100] G),
    // cCCE2, with the Knight shift (hamiltonian.cCCE.knight): the qubit's transverse field mixes its levels, which
    // shifts the 13C precession.
    //
    // The physics: a field across the NV axis mixes the NV's ms levels a little, so each 13C feels an extra field
    // through the hyperfine, of size (gamma_e B / D) A: its precession changes with the NV state. cCCE leaves this out
    // unless knight is true. T2 1.082 ms here; without it the divided curve (_wiDiv) diverges (README).
    //
    // Writes results/ccein_wi_knight_wiDiv and _noDiv (t in ms, L(t) per line). The sibling ccein_wo_knight.jsonc
    // is the same input without the "hamiltonian" block.
    // The ensemble: no configuration.s_range, the average over the unpolarised bath (one output).
    "Qubit"         : {"qubit": [{"file": "../../../basic/01_first_run/bath/bath_Diamond_NV_natab_defect"}],
                       "intmap" : [{"between": ["q0", "q0"],
                                    "tensor": [[-960000, 0, 0], [0, -960000, 0], [0, 0, 1920000]], "unit": "kHz"}]},
                                      // the NV: its position from the first line of the defect file (73.74 75.73
                                      // 73.97 A); spin 1, the electron's gyromagnetic ratio, alpha ms +1, beta ms 0
                                      // by default. intmap: the self term of "q0" (the default name of the first
                                      // qubit) is the zero-field splitting, diag(-D/3, -D/3, 2D/3) with D = 2.88 GHz,
                                      // in kHz. knight needs it (it divides by Delta = 3/2 Dzz; a qubit without one is
                                      // refused)
    "configuration" : {"gyrofile": "../../../basic/01_first_run/bath/gyro_13C",
                       "bathfile": ["../../../basic/01_first_run/bath/bath_Diamond_NV_natab_1"]},
                                      // basic/01_first_run's bath: gyro_13C (name, spin, rad kHz/G) and a 150 A cube of
                                      // diamond with 1.1 % 13C
    "order"         : 2,              // the largest cluster: single 13C and pairs (cCCE2)
    "bfield"        : [50, 0, 100],   // Gauss, [Bx, By, Bz] with z the NV axis: 112 G, tilted 27 degrees towards x.
                                      // The bare 13C precession is 120 kHz. A number is Bz alone (no Knight shift)
    "rbath"         : 50,             // Angstrom: the 978 13C within 50 A of the NV
    "rdip"          : 10,             // Angstrom: two 13C closer than 10 A form a pair cluster
    "deltat"        : 0.001,          // the time step in ms (1 us); t is the whole echo (2 tau)
    "nstep"         : 2000,           // 2000 time points: t = 0 .. 2 ms
    "pulse"         : {"count": 1},   // one pi pulse: the Hahn echo
    "hamiltonian"   : {"cCCE": {"knight": true}}
                                      // cCCE terms. knight true adds, for each bath spin and qubit branch, the Knight
                                      // shift H_K = -(3|m_s| - 2) (gamma_e / Delta) B.A~.I, A~ its hyperfine tensor
                                      // with the z row set to zero, Delta = 3/2 Dzz of the intmap. Zero when the
                                      // field is along z. Default false (ccein_wo_knight); gCCE has no such key (the
                                      // qubit is in its Hamiltonian)
}
