{
    // The coordinate-frame rotation: the bath written in the cubic crystal frame (the NV axis along [1,1,1];
    // ../bath/make_cubic_frame.py), as a bath from a conventional cubic cell would be, with frame.rotation on. CCEX
    // builds the Hamiltonian in a frame whose z is the qubit's axis and reads bfield in that frame; the rotation
    // turns every position about the qubit so that qubit_axis becomes z. The result reproduces ccein_aligned.jsonc
    // (largest difference 1e-10). Writes results/ccein_cubic_rotated_wiDiv (and _noDiv).
    // The ensemble: no configuration.s_range, the average over the unpolarised bath (one output).
    "Qubit"         : {"qubit": [{"file": "../../../basic/01_first_run/bath/bath_Diamond_NV_natab_defect"}]},
                                      // the qubit's position (x y z, Angstrom) in the bath file's frame; the
                                      // rotation turns the bath about this point (the first qubit)
    "configuration" : {"gyrofile": "../../../basic/01_first_run/bath/gyro_13C",
                       "bathfile": ["../bath/bath_Diamond_NV_natab_cubic_1"]},
                                      // gyrofile: spin and gamma of 13C; bathfile: basic/01_first_run's spins turned so
                                      // the NV axis points along [1,1,1] of the file
    "order"         : 2,              // the largest cluster: single 13C and pairs (cCCE2)
    "bfield"        : 500,            // Gauss along the new z, which is qubit_axis: 500 G along the NV axis in the
                                      // lab. With the rotation on, a field with a transverse part is refused
    "rbath"         : 50,             // Angstrom: the 13C within 50 A of the NV are kept (980, as aligned)
    "rdip"          : 10,             // Angstrom: two 13C closer than 10 A form a pair (distances do not change)
    "deltat"        : 0.001,          // the time step in ms (1 us); t is the whole sequence
    "nstep"         : 2000,           // the number of time points: t = 0 .. 1.999 ms
    "pulse"         : {"count": 1},   // one pi pulse: the Hahn echo
    "frame"         : {"rotation": {"qubit_axis": [1, 1, 1]}}
                                      // rotation: on because the block is written ("enabled": false turns it off).
                                      // qubit_axis: the qubit's axis in the bath file's frame, here [1,1,1] (the
                                      // NV axis of this file); it becomes z. Default [0, 0, 1], no turn.
                                      // Tensors, axes and Defect species with directions written in the input
                                      // must then say "frame": "file" (turned with the positions) or "qubit"
                                      // (written with qubit_axis as z); this input has none
}
