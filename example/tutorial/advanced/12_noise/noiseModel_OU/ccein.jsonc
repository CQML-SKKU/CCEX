{
    // A model of the qubit's frequency noise instead of a bath: Ornstein-Uhlenbeck noise,
    // <dnu(t) dnu(0)> = sigma^2 exp(-|t| / tau_c), and the coherence W(T) = exp(-chi(T)) under the pulse sequence
    // (exact for ideal pi pulses). No bath is read, so order, bfield, rbath, rdip and Qubit are left out (given, they
    // would not be used). Writes results/ccein_wiDiv (and _noDiv); run.sh also writes this input with pulse.count 0
    // (Ramsey) and 4 (CPMG-4) and plots the three: the echo and CPMG filter the slow noise out.
    "method"      : "noise",          // the Gaussian phase-noise coherence (default cCCE needs a bath)
    "hamiltonian" : {"noise": {"spectrum": {"model": "OU", "sigma": 10,
                                            "tau_c": {"value": 50, "unit": "us"}}}},
                                      // spectrum: the noise model. "OU": Ornstein-Uhlenbeck. sigma: the noise's
                                      // amplitude, kHz (10 kHz). tau_c: its correlation time, ms by default, here
                                      // written with a unit (50 us). A longer tau_c approaches quasi-static noise;
                                      // {"model": "power", "amplitude", "beta", "f_min", "f_max"} gives 1/f-type noise
    "deltat"      : 0.001,            // the time step in ms (1 us); t is the whole sequence
    "nstep"       : 300,              // the number of time points: t = 0 .. 0.299 ms
    "pulse"       : {"count": 1}      // one ideal pi pulse: the Hahn echo (0 Ramsey, 2 or more CPMG)
}
