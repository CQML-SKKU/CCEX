{
    // the same with cluster.mode dsjitb: the dsj groups and the pairs between them
    //
    // The physics: the product of the dsj groups (ccein.jsonc) and of the inter-bath pairs (ccein_itb.jsonc). At order 2
    // the groups are pairs and single spins, every other connected pair is an inter-bath pair, and dsjitb is the
    // standard CCE2 of ccein_standard.jsonc.
    //
    // Writes results/ccein_dsjitb_wiDiv and _noDiv (t in ms, L(t) per line).
    // The ensemble: no configuration.s_range, the average over the unpolarised bath (one output).
    "Qubit"         : {"qubit": [{"file": "../../../basic/01_first_run/bath/bath_Diamond_NV_natab_defect"}]},
                                      // the NV: its position from the first line of the defect file (73.74 75.73
                                      // 73.97 A). Not written, so the defaults: spin 1, the electron's gyromagnetic
                                      // ratio, L between ms +1 (alpha) and ms 0 (beta); no zero-field splitting,
                                      // which this cCCE does not use
    "configuration" : {"gyrofile": "../../../basic/01_first_run/bath/gyro_13C",
                       "bathfile": ["../../../basic/01_first_run/bath/bath_Diamond_NV_natab_1"]},
                                      // basic/01_first_run's bath: gyro_13C (name, spin, rad kHz/G) and a 150 A cube of
                                      // diamond with 1.1 % 13C
    "order"         : 2,              // with dsj: the largest group, here single 13C and pairs
    "bfield"        : 500,            // Gauss along z, the NV axis (the 13C precess at 535 kHz)
    "rbath"         : 50,             // Angstrom: the 978 13C within 50 A of the NV
    "rdip"          : 10,             // Angstrom: the pairs closer than 10 A are the edges of the coupling graph that
                                      // dsj groups
    "deltat"        : 0.001,          // the time step in ms (1 us); t is the whole echo (2 tau)
    "nstep"         : 2000,           // 2000 time points: t = 0 .. 2 ms
    "pulse"         : {"count": 1},   // one pi pulse: the Hahn echo
    "cluster"       : {"mode": "dsjitb"} // how the bath is cut into clusters. standard (default): every connected
                                      // cluster up to order spins. dsj: the disjoint groups above (cCCE only; gCCE,
                                      // meCCE and megCCE refuse it). itb: only the pair factors between groups;
                                      // dsjitb: both, which at order 2 equals standard CCE2 (docs/methods/cce.md)
}
