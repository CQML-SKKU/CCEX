{
    // The bundled cCCE2 Hahn echo of an NV in six P1 electron spins (bath/bath_p1_6), five sampled bath states,
    // bundles of up to dimension 4 (two P1), refined by regroup: the bundles whose states give an unphysical |L| > 1.01
    // are split or joined until every state is physical. Unlike cCCE2_Hahn_adaptive (merge, which lowers the error at
    // the bundle boundaries) regroup only aims at |L| <= 1. Here the bundles [0,3] [1,5] [2,4] give three such states;
    // one change, splitting [2,4], is accepted and the rerun is physical (status physical, exit 0). The steps go to
    // results/adaptive/. The NV position and the P1 gyromagnetic ratio are advanced/04_GPU's.
    // Sampled bath states: configuration.s_range [1, 5], each state s its own output _state<s>.
    "Qubit"         : {"qubit": [{"file": "../../04_GPU/bath/qubit_p1"}], "alpha_state": {"ms": [-1]}},
                                      // the NV (spin 1, the default) at the position in advanced/04_GPU's qubit_p1 (x y z,
                                      // Angstrom). alpha_state ms -1: L is between ms -1 and 0 (beta_state default)
    "configuration" : {"gyrofile": "../../04_GPU/bath/gyro_P1",
                       "bathfile": ["../bath/bath_p1_6"],
                       "s_range" : [1, 5],
                       "seed"    : 1},
                                      // gyrofile: the P1 line (spin 1/2, the electron's -17608.597050 rad kHz/G).
                                      // bathfile: six P1 (a count line, then "x y z P1"). s_range [1, 5]: five pure
                                      // bath states, each a random m_s per P1 drawn from seed, each its own output.
                                      // seed: also each P1's axis state of the Defect block; the refinement requires
                                      // an explicit seed (every round recomputes the same states)
    "order"         : 2,              // 2 bundles a cluster; regroup works with cCCE order 2 only
    "bfield"        : 292,            // Gauss along z, the NV axis (advanced/04_GPU's field)
    "rbath"         : 38,             // Angstrom: keeps all six P1 (the farthest is 36.5 A from the NV)
    "rdip"          : 100,            // Angstrom: every P1 pair is connected (the farthest pair is 63 A apart)
    "deltat"        : 0.0005,         // the time step in ms (0.5 us)
    "nstep"         : 30,             // 30 time points: 0 .. 14.5 us
    "pulse"         : {"count": 1},   // one pi pulse: the Hahn echo
    // P1 (substitutional N): an electron spin 1/2 whose hyperfine with its 14N shifts it by one of these detunings
    // (MHz), one per Jahn-Teller axis and 14N state; each P1 is given one of the 12 at random (from seed)
    "Defect"        : {"species": [{
        "name"          : "P1",
        "n_axis_states" : 12,
        "detuning"      : [[1, "e",  84.946496], [2, "e",  84.946496], [3,  "e",  84.946496],
                           [4, "e",   0.0],      [5, "e",   0.0],      [6,  "e",   0.0],
                           [7, "e", -84.946496], [8, "e", -84.946496], [9,  "e", -84.946496],
                           [10, "e", 114.0264],  [11, "e",  0.0],      [12, "e", -114.0264]]}]},
                                      // name: the bath file's spin name this species applies to. n_axis_states: the
                                      // number of indexed states (12 here). detuning: [axis state, "e" (the
                                      // electron), shift in MHz], a static shift of the electron; the 14N is not
                                      // a spin of its own here
    "cluster"       : {"mode": "bundle", "bundle": {"max_dim": 4},
                       "adaptive": {"workdir": "./results/adaptive", "atol": 1e-3, "rtol": 0, "regroup": true}}
                                      // mode bundle, max_dim 4: a bundle is at most two P1 (dimension 2 each).
                                      // adaptive: the refinement, with
                                      //   workdir    : folder of the steps and summary.json (required)
                                      //   atol, rtol : the tolerances of the coherence, required by the block
                                      //   regroup    : true: in place of merge's selection, find the culprit pairs
                                      //                of bundles behind the states with |L| > 1.01 and try splits
                                      //                and joins there, until every state is physical. It stops
                                      //                with exit 2 when it runs out of culprits, candidates, budget
                                      //                or changes (regroup_max_regions, regroup_max_candidates keep
                                      //                their defaults)
                                      // max_dim 8 allows bundles of three P1
}
