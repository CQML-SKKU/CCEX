{
    // ccein_standard.jsonc with bundle clustering (cluster.mode bundle): strongly coupled 13C are first tied into
    // bundles (up to dimension max_dim 8, three 13C), each bundle enters a cluster whole and is solved exactly inside
    // it, and order counts bundles. Only the cluster block differs from ccein_standard.jsonc. The [adaptive] log line
    // says how the 199 13C were bundled (84 bundles). Writes results/ccein_bundle_wiDiv and _noDiv.
    // The ensemble: no configuration.s_range, the average over the unpolarised bath (one output).
    "Qubit"         : {"qubit": [{"file": "../../../basic/01_first_run/bath/bath_Diamond_NV_natab_defect"}]},
                                      // the NV's position from basic/01_first_run's defect file; spin 1, L between ms +1
                                      // and 0 (the defaults)
    "configuration" : {"gyrofile": "../../../basic/01_first_run/bath/gyro_13C",
                       "bathfile": ["../../../basic/01_first_run/bath/bath_Diamond_NV_natab_1"]},
                                      // the 13C isotope line (rad kHz/G) and basic/01_first_run's bath, as in
                                      // ccein_standard.jsonc
    "order"         : 2,              // with bundles: the largest cluster is 2 bundles (single bundles and pairs of
                                      // connected bundles), so a cluster can hold up to six 13C here
    "bfield"        : 500,            // Gauss along z, the NV axis
    "rbath"         : 30,             // Angstrom: the 13C within 30 A of the NV (199), the same as ccein_standard
    "rdip"          : 10,             // Angstrom: with rdip given, two bundles are connected (can share a cluster)
                                      // when they have spins within 10 A (bundle.connections distance). Left out,
                                      // the run chooses the connections itself by a coherence check (checked)
    "deltat"        : 0.001,          // the time step in ms (1 us)
    "nstep"         : 2000,           // 2000 time points: 0 .. 2 ms
    "pulse"         : {"count": 1},   // one pi pulse: the Hahn echo
    "cluster"       : {"mode": "bundle", "bundle": {"max_dim": 8}}
                                      // mode bundle: the 13C pairs are taken strongest coupling first, and a pair
                                      // joins the bundles of its two spins while the product of their dimensions
                                      // stays at most bundle.max_dim (required). 8 = 2^3: up to three 13C (spin 1/2)
                                      // a bundle. 4 gives pairs, 16 four spins (larger bundles, larger clusters,
                                      // slower). bundle.merge_cutoff (default 0, rad/ms) is not written: every pair
                                      // may merge and max_dim alone limits the bundles. With every bundle a single
                                      // spin, bundle is standard CCE
}
