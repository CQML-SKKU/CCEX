{
    // The same bath, states and times as ccein_noise.jsonc, by cCCE2: each sampled state is a pure initial state of the
    // bath, which evolves under the two Hamiltonians of the qubit's states (ms -1 and 0). Writes
    // results/ccein_cce_state1_wiDiv ... state10 (and _noDiv); run.sh plots their mean against method noise's. The
    // only key that differs from ccein_noise.jsonc is method (and no hamiltonian.noise block, which cCCE refuses).
    "method"        : "cCCE",         // conventional CCE (the default, written to show the difference)
    "Qubit"         : {"qubit": [{"file": "../../../basic/05_defect_bath/bath/14N_1ppm/bath_DiaP1_1ppm_Defect"}],
                       "alpha_state": {"ms": [-1]}},
                                      // the NV's position from the first line of the file (Angstrom), spin 1 by
                                      // default; alpha_state ms -1 (beta stays ms 0), so L is between -1 and 0
    "configuration" : {"gyrofile": "../../../basic/05_defect_bath/bath/DiaP1_gyro",
                       "bathfile": ["../../../basic/05_defect_bath/bath/14N_1ppm/bath_DiaP1_1ppm_1"],
                       "s_range" : [1, 10],
                       "seed"    : 1},
                                      // gyrofile: P1 as spin 1/2 with the electron's gamma. bathfile: configuration
                                      // 1 of basic/05_defect_bath's 1 ppm baths. s_range: 10 sampled states drawn from seed (the
                                      // seed of ccein_noise.jsonc), each its own output _state<s>
    "order"         : 2,              // single P1 and pairs of P1 (cCCE2)
    "bfield"        : 500,            // Gauss along the NV axis; the P1 electrons precess at 1.40 GHz
    "rbath"         : 850,            // Angstrom: the P1 within 850 A of the NV are kept (469 here)
    "rdip"          : 620,            // Angstrom: two P1 closer than 620 A form a pair (25929 pairs here)
    "deltat"        : 0.01,           // the time step in ms (10 us); t is the whole sequence
    "nstep"         : 300,            // the number of time points: t = 0 .. 2.99 ms
    "pulse"         : {"count": 1},   // one pi pulse: the Hahn echo
    "Defect"        : {"species": [{
        "name"          : "P1",
        "n_axis_states" : 12,
        "detuning"      : [[1, "e",  84.946496], [2, "e",  84.946496], [3,  "e",  84.946496],
                           [4, "e",   0.0],      [5, "e",   0.0],      [6,  "e",   0.0],
                           [7, "e", -84.946496], [8, "e", -84.946496], [9,  "e", -84.946496],
                           [10, "e", 114.0264],  [11, "e",  0.0],      [12, "e", -114.0264]]}]}
                                      // the P1: an electron spin 1/2 shifted by its 14N hyperfine A m_I. 12 axis
                                      // states, one per Jahn-Teller axis and 14N m_I, each P1 given one from seed;
                                      // detuning [axis state, "e", MHz]: 114.0264 for the axis along the NV,
                                      // 84.946496 for the other three (see ccein_noise.jsonc)
}
