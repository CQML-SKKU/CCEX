{
    // basic/01_first_run's NV (ms +1 / 0) in natural-abundance 13C at 500 G, Hahn echo, by method noise with
    // hamiltonian.noise.compute "spectrum": besides the Gaussian coherence exp(-chi), the run writes the correlation
    // function C(t) of the qubit's frequency noise and its spectrum S(f), the quantities a noise-spectroscopy
    // experiment measures. ccein_coherence.jsonc is the same run with compute "coherence" (chi from the clusters'
    // eigenmodes directly, no time grid); the two coherences agree, which checks the FFT grid.
    //
    // Writes results/ccein_spectrum_wiDiv (the coherence), _noise_correlation (t in ms, C in kHz^2) and
    // _noise_spectrum (f in kHz, S in kHz^2/kHz, two-sided).

    "method"        : "noise",        // the Gaussian phase-noise coherence (see advanced/09_noise/README.md)
    "hamiltonian"   : {"noise": {"compute": "spectrum"}},
                                      // spectrum: C(t) on a grid of its own (hamiltonian.noise.fft; every key of it
                                      // has a default: time_max the run's last time, the number of points from the
                                      // bath's fastest modes, no window), S(f) by FFT, and chi from S(f).
                                      // "correlation" writes C(t) alone at the run's times; "coherence" is the default
    "Qubit"         : {"qubit": [{"file": "../../../basic/01_first_run/bath/bath_Diamond_NV_natab_defect"}]},
                                      // the NV position; spin 1 and ms +1 / 0 are the defaults
    "configuration" : {"gyrofile": "../../../basic/01_first_run/bath/gyro_13C",
                       "bathfile": ["../../../basic/01_first_run/bath/bath_Diamond_NV_natab_1"]},
                                      // basic/01_first_run's bath: a 150 A cube of diamond with 1.1 % 13C
    "order"         : 2,              // the noise of single 13C and of pairs (cCCE clusters)
    "bfield"        : 500,            // Gauss along the NV axis
    "rbath"         : 50,             // Angstrom: the 980 13C within 50 A
    "rdip"          : 10,             // Angstrom: pairs closer than this
    "deltat"        : 0.001,          // ms: the coherence at t = 0, 1 us, ...
    "nstep"         : 2000,           // up to 1.999 ms; also the default time_max of the C(t) grid
    "pulse"         : {"count": 1}    // Hahn echo: the filter that weighs S(f) in chi
}
