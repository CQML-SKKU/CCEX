{
    // basic/01_first_run's input by meCCE: the cCCE with a Lindblad master equation in every cluster. The jump operators
    // S- and S+ on every 13C at 0.01 rad/ms each (rate 1.5915e-6 MHz x 2 pi 10^3) relax the bath spins, so the echo
    // decays faster than cCCE's (ccein_cCCE.jsonc). Without jump operators meCCE gives the cCCE curve.
    //
    // The physics: in each cluster the bath operator <alpha|rho|beta> evolves under the two cCCE branch Hamiltonians
    // (one on each side) plus the Lindblad dissipators of the jump operators C = sqrt(gamma) S_op. The rates of all
    // the 13C add up, so even this small rate halves T2: 0.53 ms against 1.068 ms by cCCE (README). See
    // docs/methods/master-equation.md.
    //
    // Writes results/ccein_meCCE_wiDiv and _noDiv (t in ms, L(t) per line). The sibling ccein_cCCE.jsonc is the same
    // without "method" and the "hamiltonian" block. About 20 s on 4 ranks.
    // The ensemble: no configuration.s_range, the average over the unpolarised bath (one output).
    "method"        : "meCCE",        // master-equation cCCE: jump operators on the bath spins (CPU, one qubit, ideal
                                      // pi pulses). megCCE is the gCCE form, which also takes jumps of the qubit
    "Qubit"         : {"qubit": [{"file": "../../../basic/01_first_run/bath/bath_Diamond_NV_natab_defect"}]},
                                      // the NV: its position from the first line of the defect file (73.74 75.73
                                      // 73.97 A). Not written, so the defaults: spin 1, the electron's gyromagnetic
                                      // ratio, L between ms +1 (alpha) and ms 0 (beta)
    "configuration" : {"gyrofile": "../../../basic/01_first_run/bath/gyro_13C",
                       "bathfile": ["../../../basic/01_first_run/bath/bath_Diamond_NV_natab_1"]},
                                      // basic/01_first_run's bath: gyro_13C (name, spin, rad kHz/G; the name "13C" is what
                                      // bath_name below picks) and a 150 A cube of diamond with 1.1 % 13C
    "order"         : 2,              // the largest cluster: single 13C and pairs (meCCE2)
    "bfield"        : 500,            // Gauss along z, the NV axis (the 13C precess at 535 kHz)
    "rbath"         : 50,             // Angstrom: the 980 13C within 50 A of the NV
    "rdip"          : 10,             // Angstrom: two 13C closer than 10 A form a pair cluster
    "deltat"        : 0.004,          // the time step in ms (4 us; basic/01_first_run has 1 us)
    "nstep"         : 500,            // 500 time points: t = 0 .. 2 ms
    "pulse"         : {"count": 1},   // one pi pulse: the Hahn echo
    "hamiltonian"   : {"meCCE": {"jump_operators": [{"bath_name": "13C", "operator": "-", "rate": 1.5915e-6},
                                                    {"bath_name": "13C", "operator": "+", "rate": 1.5915e-6}]}}
                                      // meCCE.jump_operators: one entry per Lindblad operator sqrt(gamma) S_op, put
                                      // on every bath spin named bath_name. operator: "-" (S-) and "+" (S+) relax
                                      // the spin (T1-like, together towards the unpolarised state), "z" dephases it,
                                      // "x", "y" also allowed. rate: MHz, gamma = rate x 2 pi 10^3 rad/ms, here
                                      // 0.01 rad/ms. With no entries meCCE is the cCCE
}
