{
    // What goes wrong without the rotation: the bath written in the cubic crystal frame (the NV axis along [1,1,1],
    // ../bath/make_cubic_frame.py) and no frame block. CCEX then takes the file's z as the qubit's axis, so the field
    // "bfield": 500 along z is 54.7 degrees off the true NV axis and the curve differs from ccein_aligned.jsonc (by
    // up to 0.20 here). Writes results/ccein_cubic_norotation_wiDiv (and _noDiv). ccein_cubic_rotated.jsonc is the
    // same input with frame.rotation, which gives the aligned curve back.
    // The ensemble: no configuration.s_range, the average over the unpolarised bath (one output).
    "Qubit"         : {"qubit": [{"file": "../../../basic/01_first_run/bath/bath_Diamond_NV_natab_defect"}]},
                                      // the qubit's position (x y z, Angstrom). make_cubic_frame.py turns the spins
                                      // about the NV site, so the NV is where it was and the same file serves
    "configuration" : {"gyrofile": "../../../basic/01_first_run/bath/gyro_13C",
                       "bathfile": ["../bath/bath_Diamond_NV_natab_cubic_1"]},
                                      // gyrofile: spin and gamma of 13C; bathfile: basic/01_first_run's spins turned so
                                      // the NV axis points along [1,1,1] of the file
    "order"         : 2,              // the largest cluster: single 13C and pairs (cCCE2)
    "bfield"        : 500,            // Gauss along the file's z, which is not the NV axis here
    "rbath"         : 50,             // Angstrom: the 13C within 50 A of the NV are kept (978, as aligned)
    "rdip"          : 10,             // Angstrom: two 13C closer than 10 A form a pair (distances do not change)
    "deltat"        : 0.001,          // the time step in ms (1 us); t is the whole sequence
    "nstep"         : 2000,           // the number of time points: t = 0 .. 1.999 ms
    "pulse"         : {"count": 1}    // one pi pulse: the Hahn echo
}
