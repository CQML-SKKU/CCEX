{
    // ccein_cubic_qubit.jsonc with the Defect species declared "frame": "file". The tensors are the same numbers,
    // written in the NV frame, but now declared in the cubic file frame, so CCEX turns them once more: the wrong
    // declaration, to show what the key does.
    // Writes results/ccein_cubic_file_k1_state<s>_wiDiv and _noDiv, s = 1 .. 3.
    // Every key not written here has its default (main.out -e writes them all).

    "Qubit"         : {"qubit": [{"file": "../../../basic/06_defect_bath/bath/14N_1ppm/bath_DiaP1_1ppm_Defect"}], "alpha_state": {"ms": [1]}},
                                      // the NV. "file": the defect file next to the bath files, its first line the NV
                                      // position x y z (Angstrom). Spin 1 and the electron gyromagnetic ratio are the
                                      // defaults. alpha_state ms +1, beta_state the default ms 0: L(t) between ms +1
                                      // and 0
    "configuration" : {"gyrofile": "../../../basic/06_defect_bath/bath/DiaP1_gyro",
                       "bathfile": ["../bath/bath_DiaP1_1ppm_cubic_{k}"],
                       "k_range" : [1, 1],
                       "s_range" : [1, 3],
                       "seed"    : [1]},
                                      // gyrofile: the P1 electron as a spin 1/2 (rad kHz/G); the 14N needs no line
                                      // here, its spin and gyro are in Defect. bathfile: {k} is replaced by k = 1.
                                      // s_range: three pure bath states; each also fixes every 14N's m_I (from seed)
    "order"         : 2,              // cCCE2: single P1 and pairs of P1; a P1 counts as one, with its 14N inside
    "bfield"        : 500,            // Gauss along z, the NV axis
    "rbath"         : 850,            // Angstrom: the P1 within 850 A of the NV are kept
    "rdip"          : 620,            // Angstrom: two P1 closer than 620 A form a pair cluster
    "deltat"        : 0.01,           // ms: the time step, 10 us. t is the whole echo time 2 tau
    "nstep"         : 300,            // 300 points: t = 0 .. 2.99 ms
    "pulse"         : {"count": 1},   // one pi pulse: the Hahn echo

    // P1 with its 14N written as an on-site nuclear spin (n_onsite_spins 1): four Jahn-Teller axes, the 14N hyperfine
    // (MHz) and electric-field gradient (atomic units) per axis; the electron and its 14N enter the clusters together.
    // Each P1 is given one of the 4 axes at random (from seed; or configuration.defect_axis_file).
    "frame"         : {"rotation": {"qubit_axis": [1, 1, 1]}},
                                      // the NV axis in the cubic file frame
    "Defect"        : {"species": [{
        "name"               : "P1",
        "frame"              : "file",
                                      // the name in the bath file this species applies to
        "n_onsite_spins"     : 1,     // one nuclear spin on the defect site, the 14N; 0 (the default) is the detuning
                                      // form of cCCE2_Hahn_states
        "types"              : ["14N"],
                                      // the isotope name of each on-site spin (n_onsite_spins entries)
        "spins"              : [1],   // its nuclear spin, I = 1 for 14N
        "quadrupole_moments" : [2.044],
                                      // its electric quadrupole moment Q in fm^2 (2.044 fm^2 = 20.44 mbarn, 14N); with
                                      // "efg" it gives the quadrupole splitting of the 14N
        "gyros"              : [1.9337792],
                                      // its gyromagnetic ratio in rad kHz/G (3.0777 MHz/T for 14N); the unit form
                                      // {"values": [3.0777], "unit": "MHz/T"} is also accepted
        "n_axis_states"      : 4,     // the four Jahn-Teller axes; m_I is no longer an axis state but a spin state
        // the electron-14N hyperfine tensor per axis state, [axis state, "14N", 9 numbers xx xy xz yx yy yz zx zy zz]
        // in MHz (written here three per line). Axis 1 lies along z: diag(A_perp, A_perp, A_par) with A_perp 81.312
        // and A_par 114.0264 MHz; axes 2-4 are the same tensor turned to the three tilted bond directions (their zz
        // 84.946496 MHz is the detuning of cCCE2_Hahn_states)
        "hyperfine"          : [[1, "14N", [ 81.312000,   0.000000,   0.000000,
                                             0.000000,  81.312000,   0.000000,
                                             0.000000,   0.000000, 114.026400]],
                                [2, "14N", [103.121928,  12.591967,   8.903264,
                                            12.591967,  88.581975,   5.140302,
                                             8.903264,   5.140302,  84.946496]],
                                [3, "14N", [103.121923, -12.591970,  -8.903263,
                                           -12.591970,  88.581981,   5.140303,
                                            -8.903263,   5.140303,  84.946496]],
                                [4, "14N", [ 81.312000,  -0.000001,   0.000000,
                                            -0.000001, 110.391904, -10.280603,
                                             0.000000, -10.280603,  84.946496]]],
        // the electric field gradient at the 14N per axis state, the same layout, in atomic units (Hartree/Bohr^2).
        // Axis 1 again along z (zz -1.044681); with quadrupole_moments it gives the 14N quadrupole coupling.
        // "nuclear_positions" is not written: the 14N sits at the electron's position (default [0, 0, 0])
        "efg"                : [[1, "14N", [  0.521910,   0.000000,   0.000000,
                                              0.000000,   0.522771,  -0.000086,
                                              0.000000,  -0.000086,  -1.044681]],
                                [2, "14N", [ -0.522214,  -0.603404,  -0.426335,
                                             -0.603404,   0.174349,  -0.246178,
                                             -0.426335,  -0.246178,   0.347865]],
                                [3, "14N", [ -0.522354,   0.603323,   0.426364,
                                              0.603323,   0.174489,  -0.246128,
                                              0.426364,  -0.246128,   0.347865]],
                                [4, "14N", [  0.522771,   0.000081,  -0.000029,
                                              0.000081,  -0.870636,   0.492306,
                                             -0.000029,   0.492306,   0.347865]]]}]}
}
