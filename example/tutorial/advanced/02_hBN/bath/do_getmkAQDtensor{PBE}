#stlist=" t101 t102 t103 t104 t105 t106 t107 t108 t109 t110 t111 t112 t113 t114 t115 "
#wkdirS="${SRC_ROOT}/cal/vasp/14_hBN_tStrain{orth}/results/spinHamil/"
#wkdirO="${SRC_ROOT}/cal/vasp/14_hBN_tStrain{orth}/results/outcars/"


# A tensor, Q tensor from hBN orthrhombic cell

for i in ${stlist}
do

	fout_Afile="${wkdirS}/hBN_VB_${i}_ATensor"
	fout_Qfile="${wkdirS}/hBN_VB_${i}_QTensor"
	out="${wkdirS}/hBN_VB_${i}_mkAQ.out"

	cp ${fout_Afile} "${i}/hBN_VB_${i}_ATensor" 
	cp ${fout_Qfile} "${i}/hBN_VB_${i}_QTensor"
	cp ${out}        "${i}/hBN_VB_${i}_mkAQ.out"

done

# D tensor from hBN orth2hexa cell

for i in ${stlist}
do

	foutcar="${wkdirO}/${i}_VB_S1"
	python zfs_extractor.py ${foutcar} ./${i}/hBN_VB_${i}_DTensor

done
