{
    // V_B- (the boron vacancy, an electron spin 1) in a flat hexagonal-BN layer with natural-abundance 10B, 11B, 14N
    // (and a few 15N) at 3 T: the cCCE2 Hahn echo of the ensemble for five bath configurations (k_range [1, 5]), with
    // the DFT hyperfine and the DFT quadrupole tensors of every nuclear spin (hf3 = DFT dipole + contact, qd2 = EFG).
    //
    // The physics: every B and N site carries a nuclear spin, so the bath is dense (459 spins within rbath here).
    // 10B (I = 3), 11B (I = 3/2) and 14N (I = 1) have a quadrupole moment: the electric-field gradient (EFG) at each
    // nucleus splits its levels on top of the Zeeman term. Near the defect the hyperfine is not a point dipole (the
    // nearest 14N have A_zz 48.6 MHz), which the DFT tensors give.
    //
    // Writes results/ccein_hf3_qd2_k<k>_wiDiv and _noDiv for k = 1 ... 5, one pair per configuration (CCEX does not
    // average them; run.sh plots them). The siblings differ only in hamiltonian.common: ccein_hf0_qd2 (point-dipole
    // hyperfine, DFT quadrupole) and ccein_hf3_qd0 (DFT hyperfine, no quadrupole).
    // The ensemble: no configuration.s_range, the average over the unpolarised bath (one output).
    "Qubit"         : {"qubit": [{"file": "../../06_hBN/bath/flat/bath_hBN_VB_flat_Defect"}]},
                                      // the V_B-. "file": its position is the first line of that file (33.94 45.73
                                      // 7.50 A, in the layer at z = 7.5 A). Not written, so the defaults: spin 1, the
                                      // electron's gyromagnetic ratio, L between ms +1 (alpha) and ms 0 (beta). No
                                      // intmap (no zero-field splitting): cCCE does not use it here, it only enters
                                      // hamiltonian.cCCE.hfmedi, knight and delta_A
    "configuration" : {"gyrofile": "../../06_hBN/bath/hBN_natab_gyro",
                       "bathfile": ["../../06_hBN/bath/flat/bath_hBN_VB_flat_{k}"],
                       "k_range" : [1, 5]},
                                      // the bath. gyrofile: name, spin, gyromagnetic ratio (rad kHz/G) of 10B (3,
                                      // 2.875), 11B (3/2, 8.585), 14N (1, 1.9338), 15N (1/2, -2.713). bathfile: {k} is
                                      // replaced by each k of k_range, so bath_hBN_VB_flat_1 ... _5, five random
                                      // isotope draws of the same layer (bath/flat has 50: k_range [1, 50] for all)
    "order"         : 2,              // the largest cluster: single nuclei and pairs (cCCE2)
    "bfield"        : 30000,          // Gauss along z, the layer normal (the V_B- axis): 3 T. The nuclei precess at
                                      // 41.0 MHz (11B), 13.7 MHz (10B), 9.23 MHz (14N)
    "rbath"         : 20,             // Angstrom: the nuclei within 20 A of the V_B- (459 in each configuration).
                                      // Raise it (30) to check that the curve no longer changes
    "rdip"          : 10,             // Angstrom: two nuclei closer than 10 A form a pair cluster (a convergence knob)
    "deltat"        : 0.003,          // the time step in ms (3 us); t is the whole echo (2 tau)
    "nstep"         : 50,             // 50 time points: t = 0 .. 147 us (T2 56.5 us here, README)
    "pulse"         : {"count": 1},   // one pi pulse: the Hahn echo
    "hamiltonian"   : {"common": {
            "hyperfine"  : {"dipole": "dft", "contact": true,         // the DFT hyperfine tensors (dipolar and contact)
                            "file": "../../06_hBN/bath/flat/hBN_VB_flat_ATensor_HSE_CellPBE_v3"},
                                                                      // the qubit-nucleus coupling S.A.I. dipole dft:
                                                                      // the anisotropic part from the file, not the
                                                                      // point dipole of the positions (dipole point,
                                                                      // the default, as in ccein_hf0_qd2). contact
                                                                      // true: adds the isotropic Fermi contact part of
                                                                      // the file. file: one row per nucleus (MHz, HSE,
                                                                      // tensor format v3, tools/SpinTensorReader). A
                                                                      // nucleus in the file's range without a row stops
                                                                      // the run (missing_row stop, the default)
            "quadrupole" : {"structure": "plain",                     // the DFT electric-field gradients of the 11B,
                                                                      // 10B, 14N
                            "file": "../../06_hBN/bath/flat/hBN_VB_flat_QTensor_HSE_CellPBE"}
                                                                      // adds I.Q.I of each nucleus with I > 1/2 from
                                                                      // the EFG tensors of the file (Hartree/Bohr^2)
                                                                      // and the quadrupole moments it lists. structure
                                                                      // plain: one file computed with the defect (the
                                                                      // default "off" leaves it out, ccein_hf3_qd0)
        }}
}
