{
    // basic/06_defect_bath/cCCE2_Hahn_states with partition CCE (cluster.mode pcce): the Hahn echo of an NV in 1 ppm P1 (one bath
    // configuration, four sampled bath states). The P1 are grouped into partitions of partition_size spins (k-means
    // on the positions, the best of trials), and the CCE runs over partitions: order 2 is single partitions and pairs
    // of partitions, so a cluster holds up to 2 x partition_size P1. run.sh runs this input with partition_size 1
    // (ordinary CCE2 over single P1), 2 and 3, and writes results/sK<size>_state<s>_wiDiv and _noDiv.
    // Sampled bath states: configuration.s_range [1, 4], each state s its own output _state<s>.
    "Qubit"         : {"qubit": [{"file": "../../../basic/06_defect_bath/bath/14N_1ppm/bath_DiaP1_1ppm_Defect"}], "alpha_state": {"ms": [1]}},
                                      // the NV (spin 1, the default) at the position of basic/06_defect_bath's defect file.
                                      // alpha_state ms +1: L is between ms +1 and 0 (beta_state default)
    "configuration" : {"gyrofile": "../../../basic/06_defect_bath/bath/DiaP1_gyro",
                       "bathfile": ["../../../basic/06_defect_bath/bath/14N_1ppm/bath_DiaP1_1ppm_1"],
                       "s_range" : [1, 4],
                       "seed"    : 1},
                                      // gyrofile: the P1 line (spin 1/2, the electron's gyromagnetic ratio).
                                      // bathfile: basic/06_defect_bath's first 1 ppm configuration. s_range [1, 4]: four pure bath
                                      // states drawn from seed, each its own output; average them (more states
                                      // before reading the differences between partition sizes). seed: the states,
                                      // each P1's axis state and the partition search follow it
    "order"         : 2,              // with pcce the order counts partitions: 2 = single partitions and their pairs
    "bfield"        : 500,            // Gauss along z, the NV axis
    "rbath"         : 850,            // Angstrom: the P1 within 850 A of the NV (basic/06_defect_bath's value; its 1 ppm cells are
                                      // made for it)
    "rdip"          : 620,            // Angstrom: two partitions are connected when their centres (the k-means
                                      // centroids) are within 620 A (pcce.connections centers, the default)
    "deltat"        : 0.01,           // the time step in ms (10 us)
    "nstep"         : 300,            // 300 time points: 0 .. 2.99 ms
    "pulse"         : {"count": 1},   // one pi pulse: the Hahn echo
    "cluster"       : {"mode": "pcce", "pcce": {"partition_size": 2, "trials": 1000, "max_iterations": 1000}},
                                      // mode pcce: partition CCE. pcce block:
                                      //   partition_size : P1 per partition (required). 1 is ordinary CCE; larger
                                      //                    sizes put nearby P1 together, so order 2 reaches clusters
                                      //                    of more P1. The N mod partition_size P1 left over (the
                                      //                    last ones in the bath file) take no part
                                      //   trials         : k-means runs from different starting centres, the best
                                      //                    kept (default 30000; 1000 here for a short search)
                                      //   max_iterations : the most k-means iterations of one trial (default 30000)
                                      // connections spins (instead of centers) connects partitions whose spins are
                                      // close; it costs more
    // P1 (substitutional N): an electron spin 1/2 whose hyperfine with its 14N shifts it by one of these detunings
    // (MHz), one per Jahn-Teller axis and 14N state; each P1 is given one of the 12 at random (from seed)
    "Defect"        : {"species": [{
        "name"          : "P1",
        "n_axis_states" : 12,
        "detuning"      : [[1, "e",  84.946496], [2, "e",  84.946496], [3,  "e",  84.946496],
                           [4, "e",   0.0],      [5, "e",   0.0],      [6,  "e",   0.0],
                           [7, "e", -84.946496], [8, "e", -84.946496], [9,  "e", -84.946496],
                           [10, "e", 114.0264],  [11, "e",  0.0],      [12, "e", -114.0264]]}]}
                                      // name: the bath file's spin name this species applies to. n_axis_states: the
                                      // number of indexed states (12 here). detuning: [axis state, "e" (the
                                      // electron), shift in MHz], a static shift of the electron; the 14N is not
                                      // a spin of its own here
}
