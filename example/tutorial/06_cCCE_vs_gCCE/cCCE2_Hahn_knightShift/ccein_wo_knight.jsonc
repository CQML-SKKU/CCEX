{
    // 00_quickstart's NV (with its zero-field splitting, kHz) in a field tilted from the NV axis ([50, 0, 100] G),
    // cCCE2, without the Knight shift: the reference for ccein_wi_knight.jsonc (the qubit's transverse field mixes
    // its levels, which shifts the 13C precession; this input leaves that out).
    //
    // The physics: a field across the NV axis mixes the NV's ms levels a little, so each 13C feels an extra field
    // through the hyperfine, of size (gamma_e B / D) A: its precession changes with the NV state. Without knight
    // cCCE leaves this out, and here the divided curve (_wiDiv) diverges (|L| up to 5e5, README); the analyzer's
    // error correction (example/analysis/Analyzer, -err) repairs such a curve against _noDiv. T2 1.064 ms with it.
    //
    // Writes results/ccein_wo_knight_wiDiv and _noDiv (t in ms, L(t) per line). The sibling ccein_wi_knight.jsonc
    // is the same input with "hamiltonian": {"cCCE": {"knight": true}}.
    // The ensemble: no configuration.s_range, the average over the unpolarised bath (one output).
    "Qubit"         : {"qubit": [{"file": "../../00_quickstart/bath/bath_Diamond_NV_natab_defect"}],
                       "intmap" : [{"between": ["q0", "q0"],
                                    "tensor": [[-960000, 0, 0], [0, -960000, 0], [0, 0, 1920000]], "unit": "kHz"}]},
                                      // the NV: its position from the first line of the defect file (73.74 75.73
                                      // 73.97 A); spin 1, the electron's gyromagnetic ratio, alpha ms +1, beta ms 0
                                      // by default. intmap: the self term of "q0" (the default name of the first
                                      // qubit) is the zero-field splitting, diag(-D/3, -D/3, 2D/3) with D = 2.88 GHz,
                                      // in kHz. Without knight cCCE does not use it (the result is the same without
                                      // the intmap); kept so that the two inputs differ in knight only
    "configuration" : {"gyrofile": "../../00_quickstart/bath/gyro_13C",
                       "bathfile": ["../../00_quickstart/bath/bath_Diamond_NV_natab_1"]},
                                      // 00_quickstart's bath: gyro_13C (name, spin, rad kHz/G) and a 150 A cube of
                                      // diamond with 1.1 % 13C
    "order"         : 2,              // the largest cluster: single 13C and pairs (cCCE2)
    "bfield"        : [50, 0, 100],   // Gauss, [Bx, By, Bz] with z the NV axis: 112 G, tilted 27 degrees towards x.
                                      // The bare 13C precession is 120 kHz. A number is Bz alone (no Knight shift)
    "rbath"         : 50,             // Angstrom: the 980 13C within 50 A of the NV
    "rdip"          : 10,             // Angstrom: two 13C closer than 10 A form a pair cluster
    "deltat"        : 0.001,          // the time step in ms (1 us); t is the whole echo (2 tau)
    "nstep"         : 2000,           // 2000 time points: t = 0 .. 2 ms
    "pulse"         : {"count": 1}    // one pi pulse: the Hahn echo
}
