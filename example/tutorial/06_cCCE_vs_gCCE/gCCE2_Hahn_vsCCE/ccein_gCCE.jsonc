{
    // the same with gCCE: the qubit, a spin 1 with its zero-field splitting (kHz), is part of every cluster's
    // Hamiltonian, so qubit-bath flip-flops are kept.
    //
    // The physics: each cluster is the NV (3 levels) with its 13C, solved together, so the NV's own levels (zero-field
    // splitting and Zeeman) and the full hyperfine S.A.I enter. At 500 G along the NV axis the decay is that of cCCE
    // (T2 1.068 ms in both); the ESEEM ripple differs, by up to 0.49 in |L| (README). In a tilted or a small field
    // the two methods separate.
    //
    // Writes results/ccein_gCCE_wiDiv and _noDiv (t in ms, L(t) per line). The sibling ccein_cCCE.jsonc is
    // 00_quickstart's input by cCCE.
    // The ensemble: no configuration.s_range, the average over the unpolarised bath (one output).
    "method"        : "gCCE",         // generalized CCE: the qubit is in every cluster's Hamiltonian. The default
                                      // cCCE (ccein_cCCE) leaves it out: pure dephasing
    "Qubit"         : {"qubit": [{"file": "../../00_quickstart/bath/bath_Diamond_NV_natab_defect"}],
                       "intmap" : [{"between": ["q0", "q0"],
                                    "tensor": [[-960000, 0, 0], [0, -960000, 0], [0, 0, 1920000]], "unit": "kHz"}]},
                                      // the NV: its position from the first line of the defect file (73.74 75.73
                                      // 73.97 A); spin 1, the electron's gyromagnetic ratio, alpha ms +1, beta ms 0
                                      // by default. intmap: the self term of "q0" (the default name of the first
                                      // qubit) is the zero-field splitting S.D.S, diag(-D/3, -D/3, 2D/3) with D =
                                      // 2.88 GHz, in kHz. gCCE needs it: without it the NV levels are the Zeeman
                                      // term alone
    "configuration" : {"gyrofile": "../../00_quickstart/bath/gyro_13C",
                       "bathfile": ["../../00_quickstart/bath/bath_Diamond_NV_natab_1"]},
                                      // 00_quickstart's bath: gyro_13C (name, spin, rad kHz/G) and a 150 A cube of
                                      // diamond with 1.1 % 13C
    "order"         : 2,              // the largest cluster: single 13C and pairs, each with the NV (gCCE2)
    "bfield"        : 500,            // Gauss along z, the NV axis (the 13C precess at 535 kHz). Tilt it ([Bx, By,
                                      // Bz]) or lower it to see gCCE and cCCE differ
    "rbath"         : 50,             // Angstrom: the 980 13C within 50 A of the NV
    "rdip"          : 10,             // Angstrom: two 13C closer than 10 A form a pair cluster
    "deltat"        : 0.001,          // the time step in ms (1 us); t is the whole echo (2 tau)
    "nstep"         : 2000,           // 2000 time points: t = 0 .. 2 ms
    "pulse"         : {"count": 1}    // one pi pulse: the Hahn echo
}
