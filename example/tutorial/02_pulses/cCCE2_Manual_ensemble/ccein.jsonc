{
    // 00_quickstart's NV (ms +1 / 0, natural-abundance 13C, cCCE2, 500 G, the ensemble) under a CPMG-2 written out
    // pulse by pulse (pulse.name "Manual"). A written sequence is how to run a sequence CCEX has no name for (uneven
    // spacings such as UDD). Every key not written here has its default (`main.out -e` lists them).
    //
    // Writes results/ccein_wiDiv (and _noDiv); run.sh also runs the built-in CPMG-2 (this input with pulse
    // {"count": 2} alone, as results/builtin.json) and plots both: the two curves are identical.
    //
    // The ensemble: no configuration.s_range, the average over the unpolarised bath (one output).

    "Qubit"         : {"qubit": [{"file": "../../00_quickstart/bath/bath_Diamond_NV_natab_defect"}]},
                                      // the qubit: its position from the first line of this file (x y z, Angstrom).
                                      // Defaults: spin 1, the electron's gyromagnetic ratio, L between ms +1 and 0

    "configuration" : {"gyrofile": "../../00_quickstart/bath/gyro_13C",
                       "bathfile": ["../../00_quickstart/bath/bath_Diamond_NV_natab_1"]},
                                      // the bath: 00_quickstart's 150 A cube of diamond with 1.1 % 13C, and the
                                      // spin and gyromagnetic ratio of 13C from the gyro file

    "order"         : 2,              // the largest cluster: 2 = single 13C and pairs of 13C (cCCE2)
    "bfield"        : 500,            // magnetic field in Gauss along z, the NV axis. The 13C precess at 0.54 MHz
    "rbath"         : 50,             // Angstrom: only the 13C within 50 A of the NV are kept (980 here)
    "rdip"          : 10,             // Angstrom: two 13C closer than 10 A form a pair cluster (3366 pairs here)
    "deltat"        : 0.002,          // the time step in ms (2 us): CPMG-2 lives longer than the Hahn echo, so the
                                      // window is twice 00_quickstart's. t is the whole sequence
    "nstep"         : 2000,           // the number of time points: t = 0 .. 3.998 ms
    "pulse"         : {"count": 2, "name": "Manual",
                       "sequence": [["1/4", "X", 180.0], ["1/2", "X", 180.0], ["1/4", "I", 0.0]]}
                                      // count: the number of pulses (2). name "Manual": the sequence is written out
                                      // (without a name it follows from count: Ramsey, HahnEcho or CPMG).
                                      // sequence: count + 1 rows. Row i is [the free time before pulse i as a
                                      // fraction of t, the pulse axis X|Y|Z, its angle in degrees]; the last row is
                                      // the free time after the last pulse, with axis "I" and angle 0. The fractions
                                      // sum to 1 and may be written as "1/4" or 0.25. Here: wait t/4, pi about X,
                                      // wait t/2, pi about X, wait t/4, which is CPMG-2. cCCE takes every pulse as a
                                      // pi flip and refuses other angles; 90-degree pulses (WAHUHA) need method gCCE
}
