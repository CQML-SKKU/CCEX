{
    // 6 NV centres 50 A apart (each a spin 1 with its zero-field splitting, ms +1 / 0) and a pair of 13C near the
    // first: the Ramsey (free) evolution of the 6-qubit density matrix (quantity dm), gCCE2, the bath in the state
    // of the file state1 of ../gCCE2_HahnRamsey_NV2.
    //
    // The physics: the six NVs form one register of dimension 3^6 = 729, coupled to each other by the point dipole
    // of their positions; with the two 13C a cluster has dimension 2916. This is the NV2 calculation with four more
    // qubits, to show what a larger register costs: run it on a server node, not a laptop (README: NP=8).
    //
    // Writes results/ccein_ramsey_state1_wiDiv and _noDiv: per time step a block of the 729 x 729 density matrix,
    // basis kron(q1, ..., q6), each qubit ms +1, 0, -1 (q6 the fast index; docs/user/OutputFiles.md). The sibling
    // ccein_hahn.jsonc is the same with pulse.count 1. No expected.png yet.
    // Sampled bath states: configuration.s_range [1, 1], each state s its own output _state<s>.
    "method"        : "gCCE",         // generalized CCE: the qubits are in every cluster's Hamiltonian (quantity dm
                                      // needs it)
    "quantity"      : "dm",           // write the density matrix of the qubits at every time (gCCE only)
    "Qubit"         : {"qubit" : [
                                  {"name": "q1", "xyz": [75.663000, 74.262800, 74.134800]},
                                  {"name": "q2", "xyz": [75.663000, 74.262800, 124.134800]},
                                  {"name": "q3", "xyz": [75.663000, 124.262800, 74.134800]},
                                  {"name": "q4", "xyz": [75.663000, 124.262800, 124.134800]},
                                  {"name": "q5", "xyz": [125.663000, 74.262800, 74.134800]},
                                  {"name": "q6", "xyz": [125.663000, 74.262800, 124.134800]}],
                       "intmap": [
                                  {"between": ["q1", "q1"],
                                   "tensor": [[-960000, 0, 0], [0, -960000, 0], [0, 0, 1920000]]},
                                  {"between": ["q2", "q2"],
                                   "tensor": [[-960000, 0, 0], [0, -960000, 0], [0, 0, 1920000]]},
                                  {"between": ["q3", "q3"],
                                   "tensor": [[-960000, 0, 0], [0, -960000, 0], [0, 0, 1920000]]},
                                  {"between": ["q4", "q4"],
                                   "tensor": [[-960000, 0, 0], [0, -960000, 0], [0, 0, 1920000]]},
                                  {"between": ["q5", "q5"],
                                   "tensor": [[-960000, 0, 0], [0, -960000, 0], [0, 0, 1920000]]},
                                  {"between": ["q6", "q6"],
                                   "tensor": [[-960000, 0, 0], [0, -960000, 0], [0, 0, 1920000]]}]},
                                      // qubit: one entry per NV, its name and position xyz (Angstrom): six corners of
                                      // a 50 A cube, q1 and q2 those of ../gCCE2_HahnRamsey_NV2. Not written: spin 1
                                      // and the electron's gyromagnetic ratio for each. intmap: a pair of one name
                                      // twice is that qubit's zero-field splitting, diag(-D/3, -D/3, 2D/3) with D =
                                      // 2.88 GHz, in kHz (no "unit"). The pairs of different qubits not written get
                                      // the point dipole of the positions. alpha_state and beta_state are not
                                      // written: the defaults {"ms": [1, 1, 1, 1, 1, 1]} and {"ms": [0, 0, 0, 0, 0,
                                      // 0]}, so L is between |+1,...,+1> and |0,...,0>
    "configuration" : {"gyrofile": "../gCCE2_HahnRamsey_NV2/gyro_13C", "bathfile": ["../gCCE2_HahnRamsey_NV2/bath"],
                       "bath_state_file": ["../gCCE2_HahnRamsey_NV2/state"], "s_range": [1, 1]},
                                      // the hand-written files of ../gCCE2_HahnRamsey_NV2. gyro_13C: name, spin,
                                      // gyromagnetic ratio (rad kHz/G). bath: a count line, then x y z name (two
                                      // 13C). bath_state_file with s_range [1, 1]: the sampled state 1 is read from
                                      // state1 (the state number is appended): one m per bath spin (both +0.5)
    "order"         : 2,              // the largest cluster: one 13C or the pair, each with all six qubits (gCCE2)
    "bfield"        : 500,            // Gauss along z, the NV axis of every qubit (the 13C precess at 535 kHz)
    "rbath"         : 10000,          // Angstrom: far larger than the system, so both 13C are kept
    "rdip"          : 50000,          // Angstrom: far larger than the system, so the two 13C form a pair cluster
    "deltat"        : 0.0000001,      // the time step in ms: 1e-7 ms = 0.1 ns
    "nstep"         : 50,             // 50 time points: t = 0 .. 4.9 ns. Not 300 as in NV2: the density matrices
                                      // (8.5 MB per time step) ran out of memory at 300 (README)
    "pulse"         : {"count": 0}    // no pulse: Ramsey, the free evolution (1 is the Hahn echo of ccein_hahn)
}
