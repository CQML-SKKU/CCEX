{
    // 2 NV centres 50 A apart (each a spin 1 with its zero-field splitting, ms +1 / 0) and a pair of 13C near the
    // first: the Ramsey (free) evolution of the 2-qubit density matrix (quantity dm), gCCE2, the bath in the state
    // of the file state1.
    //
    // The physics: the two NVs form one register of dimension 3 x 3 = 9; they couple to each other by the point
    // dipole of their positions (about 0.4 MHz at 50 A) and to the two 13C (2.96 A and 6.37 A from q1, 7.97 A apart).
    // gCCE solves the register with each 13C and with the pair; the bath state is fixed by hand (both 13C m = +1/2).
    //
    // Writes results/ccein_ramsey_state1_wiDiv and _noDiv: per time step a block of the 9 x 9 density matrix, basis
    // kron(q1, q2), each qubit ms +1, 0, -1 (q2 the fast index; docs/user/OutputFiles.md). run.sh plots the element
    // between |+1,+1> and |0,0> divided by its value at t = 0. The sibling ccein_hahn.jsonc is the same with
    // pulse.count 1; ../gCCE2_HahnRamsey_NV6 is the same with six NVs.
    // Sampled bath states: configuration.s_range [1, 1], each state s its own output _state<s>.
    "method"        : "gCCE",         // generalized CCE: the qubits are in every cluster's Hamiltonian (quantity dm
                                      // needs it)
    "quantity"      : "dm",           // write the density matrix of the qubits at every time (gCCE only)
    "Qubit"         : {"qubit" : [
                                  {"name": "q1", "xyz": [75.663000, 74.262800, 74.134800]},
                                  {"name": "q2", "xyz": [75.663000, 74.262800, 124.134800]}],
                       "intmap": [
                                  {"between": ["q1", "q1"],
                                   "tensor": [[-960000, 0, 0], [0, -960000, 0], [0, 0, 1920000]]},
                                  {"between": ["q2", "q2"],
                                   "tensor": [[-960000, 0, 0], [0, -960000, 0], [0, 0, 1920000]]}]},
                                      // qubit: one entry per NV, its name (used by intmap) and position xyz
                                      // (Angstrom, the frame of the bath file); q2 is 50 A above q1 along z. Not
                                      // written: spin 1 and the electron's gyromagnetic ratio for each. intmap: a
                                      // pair of one name twice is that qubit's zero-field splitting S.D.S, here
                                      // diag(-D/3, -D/3, 2D/3) with D = 2.88 GHz, in kHz (no "unit": the log notes
                                      // it). A pair not written (q1-q2) gets the point dipole of the positions; write
                                      // {"between": ["q1", "q2"], "tensor": ...} to set it. alpha_state and beta_state
                                      // are not written: the defaults {"ms": [1, 1]} and {"ms": [0, 0]}, so L is
                                      // between |+1,+1> and |0,0>
    "configuration" : {"gyrofile": "gyro_13C", "bathfile": ["bath"], "bath_state_file": ["state"], "s_range": [1, 1]},
                                      // files of this folder, written by hand. gyro_13C: "13C 0.5 6.728284" (name,
                                      // spin, rad kHz/G). bath: a count line, then x y z name per spin (two 13C).
                                      // bath_state_file "state" with s_range [1, 1]: the sampled state 1 is read
                                      // from state1 (the state number is appended), a count line and one m per
                                      // bath spin (both +0.5), in place of a random draw
    "order"         : 2,              // the largest cluster: one 13C or the pair, each with both qubits (gCCE2)
    "bfield"        : 500,            // Gauss along z, the NV axis of both qubits (the 13C precess at 535 kHz)
    "rbath"         : 10000,          // Angstrom: far larger than the system, so both 13C are kept
    "rdip"          : 50000,          // Angstrom: far larger than the system, so the two 13C form a pair cluster
    "deltat"        : 0.0000001,      // the time step in ms: 1e-7 ms = 0.1 ns
    "nstep"         : 300,            // 300 time points: t = 0 .. 29.9 ns (|L| 0.996 at 30 ns here, README)
    "pulse"         : {"count": 0}    // no pulse: Ramsey, the free evolution (1 is the Hahn echo of ccein_hahn)
}
