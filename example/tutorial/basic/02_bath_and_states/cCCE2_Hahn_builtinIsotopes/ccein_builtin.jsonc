{
    // ccein_gyrofile.jsonc without configuration.gyrofile: every bath species is then taken from the built-in isotope
    // table (src/input/isotope_table.cpp, the EasySpin isotopes, named mass number + symbol: 1H, 13C, 14N, 29Si, ...).
    // For 13C that is spin 1/2 and gamma 6.72828544 rad kHz/G, against 6.728284 in the gyro file; over 2 ms at
    // 500 G the curves differ by about 1e-4. Writes results/ccein_builtin_wiDiv (and _noDiv); the log says that 13C
    // came from the table. Every key not written here has its default.
    //
    // A bath of other isotopes (29Si, 15N, ...) needs no gyro file. Species that are not isotopes (P1, Vp, an
    // electron spin) still need one (see basic/05_defect_bath).

    "Qubit"         : {"qubit": [{"file": "../../01_first_run/bath/bath_Diamond_NV_natab_defect"}]},
                                      // the qubit: its position from the first line of this file (x y z, Angstrom).
                                      // Defaults: spin 1, the electron's gyromagnetic ratio, L between ms +1 and 0

    "configuration" : {"bathfile": ["../../01_first_run/bath/bath_Diamond_NV_natab_1"]},
                                      // only the bath file (basic/01_first_run's 150 A cube with 1.1 % 13C); the isotope
                                      // name in its fourth column (13C) is looked up in the table

    "order"         : 2,              // the largest cluster: 2 = single 13C and pairs of 13C (cCCE2)
    "bfield"        : 500,            // magnetic field in Gauss along z, the NV axis. The 13C precess at 0.54 MHz
    "rbath"         : 50,             // Angstrom: only the 13C within 50 A of the NV are kept (980 here)
    "rdip"          : 10,             // Angstrom: two 13C closer than 10 A form a pair cluster (3366 pairs here)
    "deltat"        : 0.001,          // the time step in ms (1 us); t is the whole sequence (for the Hahn echo 2 tau)
    "nstep"         : 2000,           // the number of time points: t = 0, 1 us, ..., 1.999 ms
    "pulse"         : {"count": 1}    // one pi pulse in the middle of t: the Hahn echo
}
