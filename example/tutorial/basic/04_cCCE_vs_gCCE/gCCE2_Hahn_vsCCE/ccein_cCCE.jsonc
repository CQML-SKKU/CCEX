{
    // basic/01_first_run's input: cCCE (the default method) treats the qubit as a two-level system that only sets the
    // field each bath spin sees (pure dephasing).
    //
    // The physics: in cCCE each 13C cluster evolves under one Hamiltonian for the qubit in ms +1 and another for ms 0,
    // and L is the overlap of the two bath evolutions; the qubit never flips. At 500 G along the NV axis the decay is
    // that of gCCE (T2 1.068 ms in both); the ESEEM ripple differs, by up to 0.49 in |L| (README).
    //
    // Writes results/ccein_cCCE_wiDiv and _noDiv (t in ms, L(t) per line). The sibling ccein_gCCE.jsonc is the same
    // system by gCCE, with the NV's zero-field splitting.
    // The ensemble: no configuration.s_range, the average over the unpolarised bath (one output).
    "Qubit"         : {"qubit": [{"file": "../../01_first_run/bath/bath_Diamond_NV_natab_defect"}]},
                                      // the NV: its position from the first line of the defect file (73.74 75.73
                                      // 73.97 A). Not written, so the defaults: spin 1, the electron's gyromagnetic
                                      // ratio, L between ms +1 (alpha) and ms 0 (beta); no zero-field splitting,
                                      // which this cCCE does not use
    "configuration" : {"gyrofile": "../../01_first_run/bath/gyro_13C",
                       "bathfile": ["../../01_first_run/bath/bath_Diamond_NV_natab_1"]},
                                      // basic/01_first_run's bath: gyro_13C (name, spin, rad kHz/G) and a 150 A cube of
                                      // diamond with 1.1 % 13C
    "order"         : 2,              // the largest cluster: single 13C and pairs (cCCE2)
    "bfield"        : 500,            // Gauss along z, the NV axis (the 13C precess at 535 kHz)
    "rbath"         : 50,             // Angstrom: the 980 13C within 50 A of the NV
    "rdip"          : 10,             // Angstrom: two 13C closer than 10 A form a pair cluster
    "deltat"        : 0.001,          // the time step in ms (1 us); t is the whole echo (2 tau)
    "nstep"         : 2000,           // 2000 time points: t = 0 .. 2 ms
    "pulse"         : {"count": 1}    // one pi pulse: the Hahn echo
}
