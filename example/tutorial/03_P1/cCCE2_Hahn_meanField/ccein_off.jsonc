{
    // The Hahn echo of the NV (ms -1 / 0) in 1 ppm P1, cCCE2, ten sampled bath states: every cluster feels the static
    // field of the bath spins outside it, from their sampled states (hamiltonian.common.bath_bath_mean_field).
    // This input: "off", left out: each cluster alone in its sampled state (ccein_z.jsonc: the default "z").
    // Sampled bath states: configuration.s_range [1, 10], each state s its own output _state<s>.
    //
    // The physics: in a sampled bath state every P1 is up or down, and its dipolar field shifts the P1 around it. A
    // cluster holds only a few P1; the mean field puts back the static shift from all the others. It is what keeps
    // two P1 of a pair off resonance with each other, so it sets how fast they flip-flop. README: T2 of the mean
    // 148 us (z), 22 us (off), 148 us (xyz). Writes results/ccein_off_state<s>_wiDiv and _noDiv, s = 1 .. 10.
    //
    // The three inputs differ only in hamiltonian.common.bath_bath_mean_field. Against cCCE2_Hahn_states: one
    // configuration (no k_range), so its T2 differs from the 295 us of the mean over two.
    // Every key not written here has its default (main.out -e writes them all).

    "Qubit"         : {"qubit": [{"file": "../bath/14N_1ppm/bath_DiaP1_1ppm_Defect"}], "alpha_state": {"ms": [-1]}},
                                      // the NV. "file": the defect file next to the bath files, its first line the NV
                                      // position x y z (Angstrom). Spin 1 and the electron gyromagnetic ratio are the
                                      // defaults. alpha_state ms -1, beta_state the default ms 0: L(t) between ms -1
                                      // and 0
    "configuration" : {"gyrofile": "../bath/DiaP1_gyro",
                       "bathfile": ["../bath/14N_1ppm/bath_DiaP1_1ppm_1"],
                       "s_range" : [1, 10],
                       "seed"    : 1},
                                      // the bath. gyrofile: the P1 as a spin 1/2 with the electron's gyromagnetic
                                      // ratio (rad kHz/G). bathfile: one configuration, 469 P1 within rbath.
                                      // s_range [1, 10]: ten pure bath states, the states the mean field is taken
                                      // from (without s_range there is no mean field: the ensemble). seed: draws the
                                      // P1 axis states and the bath states; the same in the three inputs
    "order"         : 2,              // cCCE2: single P1 and pairs of P1
    "bfield"        : 500,            // Gauss along z, the NV axis
    "rbath"         : 850,            // Angstrom: the P1 within 850 A of the NV are kept
    "rdip"          : 620,            // Angstrom: two P1 closer than 620 A form a pair cluster (25929 pairs); the
                                      // P1 farther away act on a pair only through the mean field
    "deltat"        : 0.01,           // ms: the time step, 10 us. t is the whole echo time 2 tau
    "nstep"         : 300,            // 300 points: t = 0 .. 2.99 ms
    "pulse"         : {"count": 1},   // one pi pulse: the Hahn echo
    "hamiltonian"   : {"common": {"bath_bath_mean_field": "off"}},
                                      // the static (mean) field of the sampled bath spins outside a cluster on the
                                      // spins inside it, here left out: each cluster is alone in its sampled state.
                                      // Then the two P1 of a pair are no longer detuned from each other by the field
                                      // of their neighbours, they flip-flop freely and the echo decays much faster
                                      // (T2 22 us against 148 us with "z"). The default is "z"; "xyz" the whole vector

    // The P1 centre: substitutional N, an electron spin 1/2 on a 14N (I = 1). Defect.species makes every bath spin
    // named "P1" this defect. The 14N is not a spin of its own here (n_onsite_spins 0, the default): its hyperfine
    // enters only as a static shift A_zz m_I of the electron, the detuning. A P1 has four Jahn-Teller axes (the four
    // C-N bond directions) and three m_I: 4 x 3 = 12 axis states, and each P1 is given one of them at random (from
    // configuration.seed; configuration.defect_axis_file gives them from a file instead).
    "Defect"        : {"species": [{
        "name"          : "P1",       // the name in the bath file this species applies to
        "n_axis_states" : 12,         // the indexed states 1 .. 12 that "detuning" lists
        "detuning"      : [[1, "e",  84.946496], [2, "e",  84.946496], [3,  "e",  84.946496],
                           [4, "e",   0.0],      [5, "e",   0.0],      [6,  "e",   0.0],
                           [7, "e", -84.946496], [8, "e", -84.946496], [9,  "e", -84.946496],
                           [10, "e", 114.0264],  [11, "e",  0.0],      [12, "e", -114.0264]]}]}
                                      // [axis state, "e" (the electron), MHz]. 1-9: the three axes tilted from z,
                                      // A_zz 84.946496 MHz, m_I +1 (1-3), 0 (4-6), -1 (7-9). 10-12: the axis along z,
                                      // A_zz = A_par 114.0264 MHz, m_I +1, 0, -1
}
