{
    // The Hahn echo of an NV in a bath of Vp (a spin-1/2 defect without on-site nuclei: no Defect block) at 50 ppm,
    // cCCE2, one configuration and one sampled bath state.
    // Sampled bath states: configuration.s_range [1, 1], each state s its own output _state<s>.
    //
    // The physics: like the P1 bath, an electron-spin bath coupled by the magnetic dipole interaction, but every Vp has
    // the same Zeeman frequency (no 14N detunings), so every pair is on resonance apart from its neighbours' fields.
    // T2 1.4 us for this one state (README). Writes results/ccein_50ppm_state1_wiDiv and _noDiv.
    //
    // The three inputs ccein_10ppm, _12ppm, _50ppm differ in the bath files, rbath, rdip and deltat. One state per
    // concentration is not enough to compare them: README suggests s_range [1, 20] first.
    // Every key not written here has its default (main.out -e writes them all).

    "Qubit"         : {"qubit": [{"file": "../bath/Vp/50ppm/bath_DiaVp_50ppm_Defect"}], "alpha_state": {"ms": [-1]}},
                                      // the NV. "file": the defect file next to the bath file, its first line the NV
                                      // position x y z (Angstrom). Spin 1 and the electron gyromagnetic ratio are the
                                      // defaults. alpha_state ms -1, beta_state the default ms 0: L(t) between ms -1
                                      // and 0
    "configuration" : {"gyrofile": "../bath/Vp/DiaVp_gyro",
                       "bathfile": ["../bath/Vp/50ppm/bath_DiaVp_50ppm_1"],
                       "s_range" : [1, 1],
                       "seed"    : 1},
                                      // the bath. gyrofile: "Vp 0.5 -17608.597050", a spin 1/2 with the electron's
                                      // gyromagnetic ratio (rad kHz/G). bathfile: the one 50 ppm configuration of
                                      // bath/Vp, 526 Vp within rbath. No Defect block: every Vp is a plain spin of
                                      // its gyro-file line. s_range [1, 1]: one pure bath state. seed: draws it
    "order"         : 2,              // cCCE2: single Vp and pairs of Vp
    "bfield"        : 500,            // Gauss along z, the NV axis
    "rbath"         : 240,            // Angstrom: the Vp within 240 A of the NV are kept (50 ppm is denser:
                                      // a smaller radius)
    "rdip"          : 220,            // Angstrom: two Vp closer than 220 A form a pair cluster
    "deltat"        : 0.0002,         // ms: the time step, 0.2 us. t is the whole echo time 2 tau
    "nstep"         : 300,            // 300 points: t = 0 .. 59.8 us, T2 1.4 us: the decay falls in the first
                                      // points; a smaller deltat resolves it
    "pulse"         : {"count": 1}    // one pi pulse: the Hahn echo
}
