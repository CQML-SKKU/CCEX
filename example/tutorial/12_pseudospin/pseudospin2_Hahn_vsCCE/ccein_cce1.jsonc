{
    // The same run as ccein_cce2.jsonc with order 1: every nucleus alone (its ESEEM), no pairs. run.sh divides
    // cCCE2 by this curve, which leaves the exact product of the pair terms, the quantity method pseudospin models.

    "Qubit"         : {"qubit": [{"file": "../../04_hBN/bath/flat/bath_hBN_VB_flat_Defect"}]},
                                      // the defect's position (first line of the defect file); spin 1 and the
                                      // states ms +1 / 0 are the defaults
    "configuration" : {"gyrofile": "../../04_hBN/bath/hBN_natab_gyro",
                                      // spin and gyromagnetic ratio of 10B (I = 3), 11B (I = 3/2) and 14N (I = 1)
                       "bathfile": ["../../04_hBN/bath/flat/bath_hBN_VB_flat_1"]},
                                      // one configuration of the flat layer (04_hBN/bath/flat holds 50)
    "order"         : 1,              // single spins only
    "bfield"        : 30000,          // Gauss along z, the defect axis (normal to the layer): 3 T
    "rbath"         : 20,             // Angstrom: the nuclei within 20 A of the defect
    "rdip"          : 10,             // Angstrom: two nuclei closer than this form a pair cluster
    "deltat"        : 0.001,          // ms (1 us) per point
    "nstep"         : 150,            // 150 points: 0 .. 0.149 ms
    "pulse"         : {"count": 1},   // one pi pulse: the Hahn echo
    "hamiltonian"   : {"common": {
            "hyperfine"  : {"dipole": "dft", "contact": true,         // the DFT hyperfine tensors (dipolar and contact)
                            "file": "../../04_hBN/bath/flat/hBN_VB_flat_ATensor_HSE_CellPBE_v3"},
            "quadrupole" : {"structure": "plain",                     // the DFT electric-field gradients (I > 1/2)
                            "file": "../../04_hBN/bath/flat/hBN_VB_flat_QTensor_HSE_CellPBE"}
        }}
}
