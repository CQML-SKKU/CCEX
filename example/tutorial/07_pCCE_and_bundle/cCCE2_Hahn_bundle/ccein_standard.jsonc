{
    // The reference of this folder: the cCCE2 Hahn echo of 00_quickstart's NV in natural-abundance 13C, with rbath cut
    // to 30 A (199 13C) and ordinary clusters (cluster.mode standard, the default): single 13C and pairs of 13C within
    // rdip. ccein_bundle.jsonc is this input plus a cluster block; run.sh runs both and plots them together. Writes
    // results/ccein_standard_wiDiv (t in ms, L(t) as a complex number per line) and _noDiv.
    // The ensemble: no configuration.s_range, the average over the unpolarised bath (one output).
    "Qubit"         : {"qubit": [{"file": "../../00_quickstart/bath/bath_Diamond_NV_natab_defect"}]},
                                      // the qubit: the NV's position, the first line of 00_quickstart's defect file
                                      // (x y z in Angstrom). Not written, so the defaults: spin 1, the electron's
                                      // gyromagnetic ratio, and L between ms +1 (alpha_state) and ms 0 (beta_state)
    "configuration" : {"gyrofile": "../../00_quickstart/bath/gyro_13C",
                       "bathfile": ["../../00_quickstart/bath/bath_Diamond_NV_natab_1"]},
                                      // the bath. gyrofile: one line per isotope (name, spin, gyromagnetic ratio in
                                      // rad kHz/G). bathfile: 00_quickstart's 150 A cube of diamond with 1.1 % 13C
                                      // (a count line, then "x y z isotope" per spin, Angstrom)
    "order"         : 2,              // the largest cluster: 2 = single 13C and pairs (cCCE2), enough for 13C here
    "bfield"        : 500,            // magnetic field in Gauss along z, the NV axis
    "rbath"         : 30,             // Angstrom: the 13C within 30 A of the NV are kept (00_quickstart has 50), so
                                      // that both runs of run.sh take seconds; raise it for a converged curve
    "rdip"          : 10,             // Angstrom: two 13C closer than this form a pair cluster (convergence parameter)
    "deltat"        : 0.001,          // the time step in ms (1 us); t is the whole sequence (for the Hahn echo 2 tau)
    "nstep"         : 2000,           // the number of time points: 2000 x 1 us = 0 .. 2 ms
    "pulse"         : {"count": 1}    // one pi pulse: the Hahn echo (0 Ramsey, 2 or more CPMG)
}
