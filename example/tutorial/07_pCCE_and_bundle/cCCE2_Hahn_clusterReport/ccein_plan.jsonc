{
    // 00_quickstart's input (cCCE2 Hahn echo, NV in 13C, rbath 50 A) with output.cluster_only true: the run makes the
    // clusters, writes them to results/ccein_plan.clusters.json and stops before the dynamics (no coherence is
    // computed). Use it to see how many clusters an rbath and rdip give before a long run. The other two inputs of
    // this folder compute the coherence.
    // The ensemble: no configuration.s_range, the average over the unpolarised bath (one output).
    "Qubit"         : {"qubit": [{"file": "../../00_quickstart/bath/bath_Diamond_NV_natab_defect"}]},
                                      // the NV's position from 00_quickstart's defect file; spin 1, L between ms +1
                                      // and 0 (the defaults)
    "configuration" : {"gyrofile": "../../00_quickstart/bath/gyro_13C",
                       "bathfile": ["../../00_quickstart/bath/bath_Diamond_NV_natab_1"]},
                                      // the 13C isotope line (rad kHz/G) and 00_quickstart's bath (Angstrom)
    "order"         : 2,              // single 13C and pairs: the clusters listed
    "bfield"        : 500,            // Gauss along z, the NV axis
    "rbath"         : 50,             // Angstrom: the bath radius; with rdip it decides how many clusters there are
    "rdip"          : 10,             // Angstrom: two 13C closer than this form a pair cluster; raise it and the
                                      // number of pairs grows
    "deltat"        : 0.001,          // the time step in ms, kept from 00_quickstart (no dynamics is computed)
    "nstep"         : 2000,           // the number of time points, kept likewise
    "pulse"         : {"count": 1},   // one pi pulse: the Hahn echo
    "output"        : {"cluster_only": true}
                                      // cluster_only true: write <file>.clusters.json and stop before the dynamics
                                      // (cCCE, gCCE, and pcce plans with cCCE; not with cluster.mode bundle without
                                      // rdip). Default false
}
