{
    // V_B- in h-BN at zero field, gCCE2 Hahn echo between the ms = +-1 superposition and ms = 0, one sampled bath
    // state, without the Overhauser field of the bath on the qubit: the reference for ccein_wi_OH.jsonc.
    //
    // The physics: in a sampled bath state every nucleus has a definite m, so together they put a static hyperfine
    // (Overhauser) field on the qubit. Here the qubit feels only the nuclei of each cluster (through their coupling),
    // not the static field of the others. On this short window (0.49 ns) both curves dip to |L| 0.966 near 0.28 ns
    // (about 1/D) and differ by 9e-5 (README).
    //
    // Writes results/ccein_wo_OH_state1_wiDiv and _noDiv. The sibling ccein_wi_OH.jsonc has qubit_bath_mean_field
    // true; nothing else differs.
    // Sampled bath states: configuration.s_range [1, 1], each state s its own output _state<s>.
    "method"        : "gCCE",         // generalized CCE: the qubit is in every cluster's Hamiltonian (as in
                                      // ccein_wi_OH.jsonc, where the mean field on the qubit needs it)
    "Qubit"         : {"qubit"      : [{"name": "VB", "xyz": [33.94003, 45.72817, 7.50000]}],
                       "intmap"     : [{"between": ["VB", "VB"],
                                        "tensor": [[-1080, 0, 0], [0, -1180, 0], [0, 0, 2320]], "unit": "MHz"}],
                       "alpha_state": {"vector": [1, 0, 1]},              // (|+1> + |-1>)/sqrt(2), normalised by
                                                                          // the code
                       "beta_state" : {"vector": [0, 1, 0]}},             // ms 0
                                      // qubit: the V_B- by name and position (xyz, Angstrom: the first line of
                                      // bath/flat/bath_hBN_VB_flat_Defect), spin 1 and the electron's gyromagnetic
                                      // ratio by default. intmap: the self term "VB"-"VB" is the zero-field
                                      // splitting S.D.S, diag(-1080, -1180, 2320) MHz ("unit"; a plain number would be
                                      // kHz): D = 3/2 Dzz = 3.48 GHz, E = (Dxx - Dyy)/2 = 50 MHz. alpha_state,
                                      // beta_state: L(t) is the coherence between these two; a "vector" lists the
                                      // components in the order ms +1, 0, -1. At zero field with E the +-1 levels mix,
                                      // and (|+1> + |-1>)/sqrt(2) is an eigenstate of S.D.S
    "configuration" : {"gyrofile": "../bath/hBN_natab_gyro",
                       "bathfile": ["../bath/flat/bath_hBN_VB_flat_1"],
                       "s_range" : [1, 1],
                       "seed"    : 8805},
                                      // gyrofile: name, spin, gyromagnetic ratio (rad kHz/G) of 10B, 11B, 14N, 15N.
                                      // bathfile: one isotope draw of the layer. s_range [1, 1]: one sampled bath
                                      // state (as in ccein_wi_OH, whose mean field needs one), its m drawn
                                      // from seed. seed 8805: the same state in both inputs and on every run
    "order"         : 2,              // the largest cluster: single nuclei and pairs (gCCE2)
    "bfield"        : 0,              // no magnetic field (0 is required to be written)
    "rbath"         : 14,             // Angstrom: the 230 nuclei within 14 A of the V_B- are kept
    "rdip"          : 8,              // Angstrom: two nuclei closer than 8 A form a pair cluster
    "deltat"        : 0.00000001,     // the time step in ms: 1e-8 ms = 10 ps, to resolve the GHz qubit levels
    "nstep"         : 50,             // 50 time points: t = 0 .. 0.49 ns. README: nstep 1000 to see the two separate
    "pulse"         : {"count": 1},   // one pi pulse: the Hahn echo
    "hamiltonian"   : {"common": {
            "qubit_bath_mean_field" : false,                              // false (the default): the qubit feels only
                                                                          // the nuclei of its cluster, not the static
                                                                          // (Overhauser) field of the other sampled
                                                                          // nuclei. ccein_wi_OH.jsonc has true
            "hyperfine"             : {"dipole": "dft", "contact": true,  // the DFT hyperfine (dipolar and contact)
                                       "file": "../bath/flat/hBN_VB_flat_ATensor_HSE_CellPBE_v3"},
                                                                          // dipole dft: the anisotropic part from the
                                                                          // file (not the point dipole); contact true
                                                                          // adds the Fermi contact part; MHz, tensor
                                                                          // format v3
            "quadrupole"            : {"structure": "plain",              // the DFT electric-field gradients of the
                                                                          // 11B, 10B, 14N
                                       "file": "../bath/flat/hBN_VB_flat_QTensor_HSE_CellPBE"}
                                                                          // adds I.Q.I of each nucleus with I > 1/2;
                                                                          // plain: one EFG file computed with the
                                                                          // defect
        }}
}
