{
    // The run of ccein_spectrum.jsonc with compute "coherence" (the default): chi straight from every cluster's
    // eigenmodes, no time grid and no FFT. Its coherence is the reference for the spectrum run's.
    // Writes results/ccein_coherence_wiDiv.

    "method"        : "noise",        // the Gaussian phase-noise coherence (see 11_noise/README.md)
    "hamiltonian"   : {"noise": {"compute": "coherence"}},
                                      // the default, written out to show the difference to ccein_spectrum.jsonc
    "Qubit"         : {"qubit": [{"file": "../../00_quickstart/bath/bath_Diamond_NV_natab_defect"}]},
                                      // the NV position; spin 1 and ms +1 / 0 are the defaults
    "configuration" : {"gyrofile": "../../00_quickstart/bath/gyro_13C",
                       "bathfile": ["../../00_quickstart/bath/bath_Diamond_NV_natab_1"]},
                                      // 00_quickstart's bath: a 150 A cube of diamond with 1.1 % 13C
    "order"         : 2,              // the noise of single 13C and of pairs (cCCE clusters)
    "bfield"        : 500,            // Gauss along the NV axis
    "rbath"         : 50,             // Angstrom: the 980 13C within 50 A
    "rdip"          : 10,             // Angstrom: pairs closer than this
    "deltat"        : 0.001,          // ms: the coherence at t = 0, 1 us, ...
    "nstep"         : 2000,           // up to 1.999 ms; also the default time_max of the C(t) grid
    "pulse"         : {"count": 1}    // Hahn echo: the filter that weighs S(f) in chi
}
