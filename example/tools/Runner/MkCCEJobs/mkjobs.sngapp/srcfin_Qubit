#!/bin/sh

source ${src} 

B0Fix=${B0Fix}
rBathFix=${rBathFix}
rDipFix=${rDipFix}
#rDsrdrFix=${rDsrdrFix}
OrderFix=${OrderFix}
NkFix=${NkFix}
PulseFix=${PulseFix}

if [ ${VariableName} == "B0" ];then
    B0Fix=${var}
elif [ ${VariableName} == "rBath" ];then
    rBathFix=${var}
elif [ ${VariableName} == "rDip" ];then
    rDipFix=${var}
#elif [ ${VariableName} == "rDsrdr" ];then
#    rDsrdrFix=${var}
elif [ ${VariableName} == "Order" ];then
    OrderFix=${var}
elif [ ${VariableName} == "Nk" ];then
    NkFix="${NkFix}  ${var}"
elif [ ${VariableName} == "Pulse" ];then
    PulseFix=${var}
fi

qxyz_tmp="`cat "${DefectFile}"`"
qxyz=" [ "
i=0
for pos in $qxyz_tmp
do
	i=$(( ${i} + 1))
	if [ $i == 3 ]; then
		qxyz+=" ${pos}]"
	else
		qxyz+=" ${pos},"
	fi
done
echo $qxyz

# A47 (2026-10-13): the input keys of docs/user/InputFile.md. Method may be cCCE or gCCE, or a name of before (CCE,
# pCCE, dsj, itb, dsjitb), which is written as method cCCE with that cluster_mode; HFOpt is hf_readmode 0-3 of before
# (0 point dipole, 1 + Fermi contact from HFFile, 2 DFT dipole from HFFile, 3 both); switches given as 0/1 become false/true.
case "${Method}" in
    CCE|cce|cCCE|ccce) MethodKey=cCCE; ClusterMode=standard ;;
    gCCE|gcce)         MethodKey=gCCE; ClusterMode=standard ;;
    pCCE|pcce|dsj|itb|dsjitb) MethodKey=cCCE; ClusterMode=$(echo "${Method}" | tr 'A-Z' 'a-z') ;;
    *)                 MethodKey=${Method}; ClusterMode=standard ;;
esac
case "${HFOpt}" in
    1) Hyperfine="{\"dipole\": \"point\", \"contact\": true, \"file\": \"${HFFile}\"}" ;;
    2) Hyperfine="{\"dipole\": \"dft\", \"contact\": false, \"file\": \"${HFFile}\"}" ;;
    3) Hyperfine="{\"dipole\": \"dft\", \"contact\": true, \"file\": \"${HFFile}\"}" ;;
    *) Hyperfine="{\"dipole\": \"point\", \"contact\": false}" ;;
esac
switch(){ case "$1" in 1|true) echo true ;; *) echo false ;; esac; }

cat << EOF > ${fccein}
{
    # Config - Method 
    "method"        : "${MethodKey}",
    "cluster_mode"  : "${ClusterMode}",
    "quantity"      : "coherence",
    
    # Config - File
    "gyrofile"      :  "${GyroFile}",
    "bathfile"      : ["${BathFile}"],
    #"bath_state_file" :  "${StateFile}",

    # Config - General
    "order"         : ${OrderFix},
    "bfield"        : ${B0Fix},
    "rbath"         : ${rBathFix},
    "rdip"          : ${rDipFix},
    "deltat"        : ${deltaTFix},
    "nstep"         : ${nStepFix},  

    # Qubit (alphaFix/betaFix are the qubit's alphams/betams)
    "Qubit"   : {
                   "qubit"  : [ 
                   {   
                       "name"   : "qubit1",
                       "spin"   : 1.0,
                       "gyro"   : -17608.597050,
                       "xyz"    : ${qxyz},
                       "alphams": ${alphaFix},
                       "betams" : ${betaFix},
                       "detuning": [0.0]
                   }]  
    }, 

    # Cluster
    "add_subclusters"        : $(switch ${addClus}), # true / false
    "max_clusters_per_order" : ${NkFix}, # default : [0] (all) or [0,0,30,40,50]

    # Pulse
    "pulse"       : {"count": ${PulseFix}},

    # Config - Spin tensor
    "hamiltonian"   : {"common": {"hyperfine": ${Hyperfine}}},
#  quadrupole : "off" (default) or {"structure": "plain", "file": ...} in hamiltonian.common

    # Output
    "savemode"    : "coherence"

EOF

# CCEinFile holds the Defect species, written with the keys of docs/user/InputFile_Defect.md (name, n_nuclear_spins,
# n_configurations, ...); the axis and state files of the defects sit beside the list
if [ -f ${CCEinFile} ]; then
    echo ",  \"Defect\"         : {" >> ${fccein}
    echo "  #\"axis_file\"     :  \"${AvaaxFile}\"," >> ${fccein}
    echo "  #\"state_file\"    :  \"${ExStateFile}\"," >> ${fccein}
    echo "       \"species\"      : [" >> ${fccein}
    cat ${CCEinFile} >> ${fccein}
    echo "                       ]}" >> ${fccein}
else
    echo "   ! Warning. CCEinFile :  ${CCEinFile} doesn't exist"
fi

echo "}" >> ${fccein}

